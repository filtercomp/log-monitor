# ============================================================
# 环境：eu（APISIX）
# 部署：./deploy.sh eu
# 按实际集群修改 CLUSTER_NAME、INCLUDE_NAMESPACES、WEB_BASE_URL
# ============================================================

CLUSTER_NAME=eu-prod

ERROR_LOG_DIR=/tmp/logs/error
CHECK_INTERVAL_HOURS=2
SNAPSHOT_LINES=2000

# 与 deploy/envs/eu/gateway.yaml 里的 host 保持一致
WEB_BASE_URL=https://kafree-eu-log-monitor.coffee-iot.com

ALERT_HOURS=9,11,13,15,17
MAX_MESSAGES=20

INCLUDE_NAMESPACES=kafree-swarm

EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,default,infrastructure

EXCLUDE_CONTAINERS="^(istio-proxy|linkerd-proxy|.*-init)$"

DRY_RUN=false

# ---- 部署参数（monitor.sh 不使用，供 deploy.sh 读取）----
IMAGE=registry.cn-hangzhou.aliyuncs.com/kafree/log-monitor:1.2.2

# 目标命名空间内的拉取凭据 Secret 名称；留空则部署时移除 imagePullSecrets
IMAGE_PULL_SECRET=acr

# 从哪个命名空间的哪个 Secret 复制凭据（两项都为空则跳过复制）
SOURCE_PULL_SECRET_NAMESPACE=kafree-swarm
SOURCE_PULL_SECRET_NAME=acr
