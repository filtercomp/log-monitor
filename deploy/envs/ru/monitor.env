# ============================================================
# 环境：ru（APISIX）
# 部署：./deploy.sh ru
# 按实际集群修改 CLUSTER_NAME、INCLUDE_NAMESPACES、WEB_BASE_URL
# ============================================================

CLUSTER_NAME=ru-prod

ERROR_LOG_DIR=/tmp/logs/error
SCAN_INTERVAL_SECONDS=60
ACTIVE_HOURS=9-17
RECENT_WINDOW_MINUTES=5
RECOVERY_MINUTES=20
RENOTIFY_HOURS=2
SNAPSHOT_LINES=2000

# 与 deploy/envs/ru/gateway.yaml 里的 host 保持一致
WEB_BASE_URL=https://kafree-ru-log-monitor.coffee-iot.com

MAX_MESSAGES=20

# 只扫描业务命名空间，多个用英文逗号分隔
INCLUDE_NAMESPACES=kafree-swarm

EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,default,infrastructure

EXCLUDE_CONTAINERS="^(istio-proxy|linkerd-proxy|.*-init)$"

DRY_RUN=false

# ---- 部署参数（monitor.sh 不使用，供 deploy.sh 读取）----
# 海外集群镜像仓库按实际修改；必须与 CN 构建出的镜像内容一致
IMAGE=registry.cn-hangzhou.aliyuncs.com/kafree/log-monitor:1.3.0

# 目标命名空间内的拉取凭据 Secret 名称；留空则部署时移除 imagePullSecrets
# 如果海外集群不需要私有仓库认证，保持为空
IMAGE_PULL_SECRET=

# 从哪个命名空间的哪个 Secret 复制凭据（两项都为空则跳过复制）
SOURCE_PULL_SECRET_NAMESPACE=
SOURCE_PULL_SECRET_NAME=
