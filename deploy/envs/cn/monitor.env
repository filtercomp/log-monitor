# ============================================================
# 环境：cn（ACK，ALB Ingress）
# 部署：./deploy.sh cn
# ============================================================

# 集群名称，会出现在告警消息里
CLUSTER_NAME=cn-prod

# 容器内错误日志目录（各服务统一的约定路径）
ERROR_LOG_DIR=/tmp/logs/error

# 巡检间隔（秒）
SCAN_INTERVAL_SECONDS=300

# 运行时段（Asia/Shanghai），9-17 表示 09:00-17:59；时段外只更新页面，不推送告警
ACTIVE_HOURS=9-17

# 每次巡检回看的窗口（分钟），只处理窗口内有写入的日志文件
RECENT_WINDOW_MINUTES=6

# 连续多少分钟无新增错误判定为恢复
RECOVERY_MINUTES=20

# 同一工作负载持续报错时的重复提醒间隔（小时）
RENOTIFY_HOURS=2

# 每个 Pod/容器 保留的最新日志行数（页面可查看的原始行数上限）
SNAPSHOT_LINES=2000

# 告警消息里的页面链接前缀（为空则消息中不带链接）
WEB_BASE_URL=https://kafree-cn-log-monitor.coffee-iot.com

# 单次巡检最多发送多少条告警，超出部分只发汇总
MAX_MESSAGES=20

# 为空表示扫描所有命名空间（再排除 EXCLUDE_NAMESPACES）；
# 填了就只扫描这里列出的命名空间，多个用英文逗号分隔
INCLUDE_NAMESPACES=kafree-swarm

# 不监控的命名空间，多个用英文逗号分隔
EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease,default,ack-csi-fuse,arms-prom,security-inspector,kruise-rollout,infrastructure

# 不进入的容器（正则），默认跳过 mesh sidecar；值必须加引号，否则 source 时会语法报错
EXCLUDE_CONTAINERS="^(istio-proxy|linkerd-proxy|.*-init)$"

# true 只打印不推送，false 真实推送
DRY_RUN=false

# ---- 部署参数（monitor.sh 不使用，供 deploy.sh 读取）----
# 镜像地址，其他环境可换成当地仓库
IMAGE=registry.cn-hangzhou.aliyuncs.com/kafree/log-monitor:1.4.4

# 目标命名空间内的拉取凭据 Secret 名称；留空则部署时移除 imagePullSecrets
IMAGE_PULL_SECRET=acr

# 从哪个命名空间的哪个 Secret 复制凭据（两项都为空则跳过复制）
SOURCE_PULL_SECRET_NAMESPACE=kafree-swarm
SOURCE_PULL_SECRET_NAME=acr
